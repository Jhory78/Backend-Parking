# Copiar a .env y ajustar los valores: cp .env.example .env
# docker compose lee .env automáticamente. Nunca subir .env al repositorio.

# ── Base de datos ───────────────────────────────────────────────
POSTGRES_DB=parking_db
POSTGRES_USER=parking_user
POSTGRES_PASSWORD=cambiar-esta-clave
# Puerto del host para conectarse a Postgres desde fuera de Docker
POSTGRES_PORT=5433

# ── Aplicación ──────────────────────────────────────────────────
APP_PORT=9200

# Clave HMAC en Base64 de al menos 256 bits. Generar con: openssl rand -base64 32
APP_JWT_SECRET=generar-una-clave-base64
APP_JWT_EXPIRATION=24h

# Cuenta de administrador que se crea al arrancar si no existe
APP_ADMIN_NAME=Administrador
APP_ADMIN_EMAIL=admin@parking.com
APP_ADMIN_PASSWORD=cambiar-esta-clave

# Orígenes del frontend (Angular), separados por comas
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Duración de cada conexión en tiempo real (el cliente se reconecta después)
APP_SPACES_STREAM_TIMEOUT=30m

# ── Reconocimiento de placas (OCR) ──────────────────────────────
# API key de Plate Recognizer (https://app.platerecognizer.com). Sin ella, toda foto
# responde 422 y el operario registra la placa a mano.
APP_OCR_PLATE_RECOGNIZER_API_KEY= Api-de-plate-recognizer
# Lecturas con confianza menor se marcan como lowConfidence para que el operario las revise
APP_OCR_CONFIDENCE_THRESHOLD=0.80
APP_OCR_TIMEOUT=10s
